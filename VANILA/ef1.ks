clearscreen.
print "3".
wait 1.
clearscreen.
print "2".
wait 1.
clearscreen.
print "1".
wait 1.
clearscreen.
print "mark".
stage.
lock throttle to 1.
lock steering to up + r(0,0,90).
wait 5.
lock steering to up + r(0, -5, 90).
wait 60.
lock throttle to 0.
lock steering to srfretrograde.
wait 30.
lock throttle to 0.7.
wait 20.
lock throttle to 0.
print "test done".

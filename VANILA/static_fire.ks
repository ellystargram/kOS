print "you just actived static_fire".
wait 2.
set x to 5.
clearscreen.
print "t-"+ x.
wait 1.
set x to 4.
clearscreen.
print "t-"+ x.
wait 1.
set x to 3.
clearscreen.
print "t-"+ x.
wait 1.
set x to 2.
clearscreen.
print "t-"+ x.
wait 1.
set x to 1.
clearscreen.
print "t-"+ x.
wait 1.
set x to 0.
clearscreen.
print "t="+ x.
stage.
lock throttle to 0.5.
wait 1.
set x to 1.
clearscreen.
print "t+"+ x.
wait 1.
set x to 2.
clearscreen.
print "t+"+ x.
wait 1.
set x to 3.
clearscreen.
print "t+"+ x.
lock throttle to 0.
